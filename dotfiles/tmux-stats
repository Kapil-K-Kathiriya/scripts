#!/usr/bin/env bash

# CPU usage percentage
CPU=$(mpstat 1 1 | awk '/Average:/ {printf "%.0f", 100-$NF}')

# RAM used, total and percentage
RAM=$(free -b | awk '/Mem:/ {
    used=$3
    total=$2
    percent=(used/total)*100
    printf "%.1f/%.1f GB (%.0f%%)", used/1024/1024/1024, total/1024/1024/1024, percent
}')

printf " CPU %s%%  │  RAM %s " "$CPU" "$RAM"
